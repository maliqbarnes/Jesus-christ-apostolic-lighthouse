# ==========================================
# JCAL MINISTRIES PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================

# 1. APPLICATION
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://jcal-ministries.vercel.app

# 2. AUTHENTICATION & SESSION
# Must be at least 32 characters long. Generate via: openssl rand -hex 32
SESSION_SECRET=

# 3. MONGODB ATLAS DATABASE
# Connection URI for production MongoDB Atlas cluster
MONGO_URI=

# 4. STREAMING PROVIDER (Livepeer Studio or Mux)
# Supported options: 'livepeer' or 'mux'
STREAM_PROVIDER=livepeer

# Livepeer Studio Credentials
LIVEPEER_API_KEY=

# Mux Credentials (Required if STREAM_PROVIDER=mux)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_PLAYBACK_ID=

# Primary Production HLS Playback URL (.m3u8)
STREAM_PLAYBACK_URL=

# 5. STORAGE PROVIDER (Cloudinary or AWS S3)
# Supported options: 'cloudinary' or 's3'
STORAGE_PROVIDER=cloudinary

# Cloudinary Credentials
CLOUDINARY_URL=

# AWS S3 Credentials (Required if STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CLOUDFRONT_URL=

# 6. REALTIME SERVICE
SOCKET_IO_PORT=3000

# 7. EMAIL & NOTIFICATIONS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 8. MONITORING & OBSERVABILITY
LOG_LEVEL=info
SENTRY_DSN=
