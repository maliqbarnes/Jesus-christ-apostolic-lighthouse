# Application Environment Variables Template (No Secrets)

NODE_ENV=development
PORT=3000
SESSION_SECRET=

# Database Configuration (MongoDB Atlas)
MONGO_URI=

# Live Streaming Provider Configuration (Livepeer / Mux)
STREAM_PROVIDER=livepeer
LIVEPEER_API_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
STREAM_PLAYBACK_URL=

# Media Storage Configuration (Cloudinary / AWS S3)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
